---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	plan(plan)
	answer(answer)
	fixed(fixed)
	check(check)
	finish(finish)
	__end__([<p>__end__</p>]):::last
	__start__ --> plan;
	answer --> check;
	check -.-> answer;
	check -.-> finish;
	fixed --> finish;
	plan -.-> answer;
	plan -.-> check;
	plan -.-> fixed;
	finish --> __end__;
	plan -.-> plan;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
