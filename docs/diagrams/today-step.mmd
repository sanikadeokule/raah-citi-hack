---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	observe(observe)
	options(options)
	decide(decide)
	check(check)
	__end__([<p>__end__</p>]):::last
	__start__ --> observe;
	check -.-> __end__;
	check -.-> decide;
	decide --> check;
	observe -.-> options;
	options --> decide;
	observe -.-> observe;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
