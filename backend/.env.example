# Copy to .env and fill in. Never commit .env.
# Leave unset to use raah-dataset.xlsx in the repository root
# RAAH_DATASET=../raah-dataset.xlsx
# Voice (text-to-speech and voice typing). Providers are tried in order; a provider without keys is skipped.
# With none configured the app uses the phone's own voices.
VOICE_PROVIDERS=bhashini,sarvam
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd
# SARVAM_API_KEY (below, shared with the AI chat) also turns on Sarvam voice
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_TTS_SPEAKER=anushka
SARVAM_TTS_SPEAKER_MALE=abhilash
SARVAM_ASR_MODEL=saarika:v2.5
RAAH_SIGNING_KEY=change-me
# Google OAuth2 (optional — enables "Sign in with Google")
# Create credentials at console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client IDs
# Redirect URI to register: http://localhost:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
FRONTEND_URL=http://localhost:8000
PARTNER_CLIENT_ID=demo-employer
PARTNER_CLIENT_SECRET=demo-secret
# Database: PostgreSQL (required). backend/scripts/setup_postgres.ps1 / .sh or `docker compose up -d db` creates this one.
DATABASE_URL=postgresql://raah:raah@localhost:5432/raah
# Sign-in tokens
RAAH_TOKEN_TTL_DAYS=30
# Comma-separated mobile numbers allowed to register as teachers
RAAH_TEACHER_PHONES=9000000001,9876543232
# AI chat. Providers are tried in order; with none reachable the app uses its scripted flow.
# For finals / no GPU: LLM_PROVIDERS=openai,groq  (OpenAI first, Groq as free fallback)
LLM_PROVIDERS=openai,groq
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:12b
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-m
# Generated speech is cached here so each lesson or message is synthesised once
RAAH_TTS_CACHE=data/tts
# Interest matching: free text in any language -> spreadsheet tags. Pull the model once: ollama pull bge-m3
EMBED_PROVIDERS=ollama,sentence-transformers
OLLAMA_EMBED_MODEL=bge-m3
EMBED_MODEL=intfloat/multilingual-e5-small
EMBED_MIN_SCORE=0.45
# Official ISO 20022 schema for payment files (fetch with scripts/fetch_iso_schema.py)
RAAH_PAIN001_XSD=schemas/pain.001.001.09.xsd
# Ask Raah (RAG): share of the vector score in the hybrid search, and chunks given to the model
RAG_ALPHA=0.7
RAG_TOP_K=6
# Optional: push the index to a Weaviate server (vector + BM25). Empty = in-memory index
WEAVIATE_URL=
