# Copy to .env and fill in. Never commit .env.
RAAH_DATASET=../../raah-dataset.xlsx
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd
RAAH_SIGNING_KEY=change-me
PARTNER_CLIENT_ID=demo-employer
PARTNER_CLIENT_SECRET=demo-secret
# Login
RAAH_DB=data/raah.db
RAAH_TOKEN_TTL_DAYS=30
# Comma-separated mobile numbers allowed to sign in as teachers
RAAH_TEACHER_PHONES=9000000001
# Leave SMS_PROVIDER empty for sandbox mode (fixed OTP below, shown on the login screen)
SMS_PROVIDER=
RAAH_SANDBOX_OTP=123456
# AI chat (open-source models). Providers are tried in order; with none reachable the app uses its scripted flow.
LLM_PROVIDERS=ollama,groq
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:12b
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-m
# Generated speech is cached here so each lesson or message is synthesised once
RAAH_TTS_CACHE=data/tts
